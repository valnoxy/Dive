<ui:FluentWindow x:Class="Dive.UI.SplashScreen"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Dive" Height="300" Width="560"
        ResizeMode="NoResize"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Background="{ui:ThemeResource ApplicationBackgroundBrush}"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round"
        WindowStartupLocation="CenterScreen"
        Loaded="SplashScreen_OnLoaded">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Branding -->
        <Border Grid.Column="0">
            <Border.Background>
                <ImageBrush
                    ImageSource="pack://application:,,,/Assets/dash.png"
                    RenderOptions.BitmapScalingMode="HighQuality"
                    Stretch="UniformToFill" />
            </Border.Background>
            <Border>
                <Border.Background>
                    <RadialGradientBrush>
                        <GradientStop Offset="0" Color="#1F000000" />
                        <GradientStop Offset="1" Color="#4F000000" />
                    </RadialGradientBrush>
                </Border.Background>
                <Grid>
                    <StackPanel Margin="32,0" VerticalAlignment="Center">
                        <TextBlock FontSize="32" FontWeight="Bold" Foreground="#FFFFFF" Text="Dive" />
                        <TextBlock FontSize="14" Foreground="#B7FFFFFF" x:Name="VersionLabel" Text="Version" />
                    </StackPanel>
                    <TextBlock
                        Margin="12"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        FontSize="10"
                        Foreground="#57FFFFFF"
                        Text="Created with ♥️ by valnoxy" />
                </Grid>
            </Border>
        </Border>

        <!-- Progress -->
        <Grid Grid.Column="1" Margin="28,0,28,28">
            <StackPanel VerticalAlignment="Center">
                <TextBlock
                    FontSize="22"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                    Text="Deployment is very easy" />
                <TextBlock
                    Margin="0,4,0,0"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    x:Name="BranchLabel" />
            </StackPanel>

            <StackPanel VerticalAlignment="Bottom">
                <TextBlock
                    x:Name="StatusText"
                    Margin="0,0,0,8"
                    TextTrimming="CharacterEllipsis"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{DynamicResource SplashInitializing}" />
                <ProgressBar x:Name="StatusProgress" IsIndeterminate="True" />
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
